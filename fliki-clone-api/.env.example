# ── Stripe（Track-11 计费对接）─────────────────────────────────────────────
# 完整 .env 请参考 .env（本地）或上一份 Session 的 SESSION_HANDOFF.md；
# 这里只列 Track-11 涉及的最小必要变量。
#
# STRIPE_SECRET_KEY：从 https://dashboard.stripe.com/test/apikeys 拿 sk_test_*
STRIPE_SECRET_KEY=sk_test_...
#
# STRIPE_WEBHOOK_SECRET：本地用 `stripe listen --forward-to http://127.0.0.1:8000/api/billing/webhook`
# 命令会打印 whsec_*；生产用 dashboard 创建 endpoint 后拿
STRIPE_WEBHOOK_SECRET=whsec_...
#
# Plan price_id：在 Stripe Dashboard → Products 里拿。
# - Free 档目前不真扣款；可留空（webhook 收到 paid 才升级）；
#   设了就允许把 free 也接入 Checkout 流程（拿 customer_id 提前建档）
STRIPE_PRICE_FREE=
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PREMIUM=price_...

# ── SMTP（Track-22 月账单 PDF + 邮件）────────────────────────────────────────
# 缺 SMTP_HOST / SMTP_USER / SMTP_PASSWORD 任意一项 → services/email 抛
# EmailNotConfigured；webhook handler 翻 {handled:True, sent:False} 让 stripe
# 不重投。本地测试推荐 mailpit / smtp4dev（直接 docker 起一个 1025 端口的
# 假 smtp，浏览器看收件箱）。
#
# Gmail 用户：开 https://myaccount.google.com/apppasswords 拿 16 位 App Password；
# Resend / Mailgun / SES 都符合 stdlib smtplib 协议，直接配它们的 SMTP relay 即可。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 缺省时 fallback 到 SMTP_USER；再缺省到 noreply@<SMTP_HOST>
SMTP_FROM=
# STARTTLS（587 默认 true）；改 465 时把 SMTP_USE_TLS=false + SMTP_USE_SSL=true
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# 主开关：缺省 false 不真发；生产环境显式 true 才发（webhook 缺省路径返
# {handled:True, sent:False, reason:"invoice_email_enabled=false"}）
INVOICE_EMAIL_ENABLED=false

# ── Admin 邮箱白名单（Track-23）───────────────────────────────────────────
# 逗号分隔；命中的 user.email 走 admin_flags / cost 等管理端点的 _require_admin。
# 留空或不设 → fallback 到 demo@example.com（与 dev fixtures 对齐，本地开箱可测）。
ADMIN_EMAILS=demo@example.com,you@example.com

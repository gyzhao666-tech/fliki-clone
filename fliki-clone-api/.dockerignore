# Track-28 · backend build context 实际生效的 .dockerignore
.git
.gitignore
.cursor
.vscode
.idea

# Python
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.coverage
coverage
htmlcov

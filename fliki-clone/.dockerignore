# Track-28 · frontend build context 实际生效的 .dockerignore
.git
.gitignore
.cursor
.vscode
.idea

# Node 产物（builder 阶段重新装 / 重新 build）
node_modules
.next
.turbo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# tsbuildinfo 增量缓存（容器里不复用）
tsconfig.tsbuildinfo

# Env / secrets（前端 NEXT_PUBLIC_ 通过 docker-compose environment 注入）
.env
.env.*
!.env.example

# 文档
*.md

# 编辑器 / OS
*.swp
.DS_Store
